{
  "name": "vite-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/local-dev.mjs",
    "dev": "node scripts/update-version.mjs && vite",
    "build": "node scripts/update-version.mjs --increment && tsc -b && vite build",
    "version:sync": "node scripts/update-version.mjs",
    "version:bump": "node scripts/update-version.mjs --increment",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "local": "node scripts/local-dev.mjs",
    "local:check": "node scripts/local-dev.mjs --check",
    "local:repair": "node scripts/local-dev.mjs --repair",
    "local:stop": "node scripts/local-dev.mjs --stop",
    "nas": "node scripts/nas-setup.mjs",
    "nas:check": "node scripts/nas-setup.mjs --check",
    "nas:doctor": "node scripts/nas-setup.mjs --doctor",
    "nas:backup": "node scripts/nas-backup.mjs",
    "convex:up": "docker compose -f docker/convex/docker-compose.yml up -d",
    "convex:down": "docker compose -f docker/convex/docker-compose.yml down",
    "convex:logs": "docker compose -f docker/convex/docker-compose.yml logs -f backend",
    "convex:admin-key": "docker compose -f docker/convex/docker-compose.yml exec -T backend ./generate_admin_key.sh",
    "convex:dev": "convex dev",
    "convex:push": "convex dev --once",
    "auth:keys": "node scripts/generate-keys.mjs --set"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.96",
    "@hookform/resolvers": "^5.9.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@oslojs/crypto": "^1.0.1",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-aspect-ratio": "^1.1.16",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-hover-card": "^1.1.24",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-menubar": "^1.1.25",
    "@radix-ui/react-navigation-menu": "^1.3.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toggle": "^1.1.19",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@vly-ai/integrations": "^0.6.14",
    "@zumer/snapdom": "^2.0.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.46.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.16",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.25",
    "hono": "^4.13.13",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.555.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-day-picker": "9.13.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-resizable-panels": "^3.0.6",
    "react-router": "^7.18.4",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vaul": "^1.1.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "convex-test": "^0.0.61",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.2.6",
    "vitest": "^5.0.3"
  }
}
