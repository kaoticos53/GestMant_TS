# Plantilla de variables de entorno.
#
# Para desarrollo local, copia este archivo a `.env.local` y rellena la clave
# de administrador con `npm run convex:admin-key`:
#
#   cp .env.example .env.local
#
# `.env.local` está en .gitignore — no lo subas al repositorio.

# --- CLI de Convex → backend autoalojado (docker/convex) ---
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# Clave de administrador del backend local. Se obtiene con:
#   npm run convex:admin-key
CONVEX_SELF_HOSTED_ADMIN_KEY=

# --- Cliente React (Vite) → API de Convex ---
VITE_CONVEX_URL=http://127.0.0.1:3210

# --- Convex Auth ---
# Puerto de las "http actions" del backend. La usa auth.config.ts como dominio
# y como emisor del JWT de sesión.
CONVEX_SITE_URL=http://127.0.0.1:3211
# URL pública de la app; Convex Auth redirige aquí tras el login.
SITE_URL=http://localhost:5173
# Correo del administrador inicial para el primer despliegue (opcional)
INITIAL_ADMIN_EMAIL=

# --- Barra de previsualización del editor (solo desarrollo) ---
# No entra en la aplicación salvo que se encienda aquí: es una ayuda para
# inspeccionar la interfaz mientras se diseña, no una pieza del taller.
# VITE_VLY_TOOLBAR=true

# --- Integraciones de la plataforma (solo si despliegas en freebuff.com) ---
# No hacen falta en local: el acceso por contraseña funciona sin ellas. El código
# por email sí necesita VLY_INTEGRATION_KEY.
# VLY_INTEGRATION_KEY=
# VLY_INTEGRATION_BASE_URL=https://integrations.freebuff.com/

# --- Correo saliente (opcional) ---
# El servicio de envío se elige desde Ajustes del taller, junto con el remitente
# y la prueba de envío; la clave se puede guardar allí o dejarla en el entorno.
# Si no tocas nada, el correo sale por la pasarela de la plataforma. Un servidor
# SMTP propio se usa a través de un relevo HTTP («Relevo propio»), porque el
# backend no abre conexiones TCP; por el mismo puente salen «Gmail (Google)» y
# «Ethereal (pruebas)», que le mandan su servidor y su cuenta en el sobre.
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# BREVO_API_KEY=
# MAIL_RELAY_TOKEN=
# Contraseña de aplicación de la cuenta de Google, si se prefiere no guardarla en
# los ajustes del taller. El buzón de pruebas de Ethereal no tiene variable: sus
# credenciales se guardan en los ajustes.
# GMAIL_APP_PASSWORD=
