[TEMPLATE]
# Variables del proyecto de Container Manager.
#
# Este archivo se copia en el NAS como `.env`, junto al docker-compose.yml, y lo
# lee Compose al arrancar el proyecto. Nada de esto va al repositorio.
#
#   /volume1/docker/pulso-taller/.env

# El nombre de la instancia. Es una etiqueta: da igual cuál sea, pero mejor no
# cambiarla después de arrancar.
INSTANCE_NAME=pulso-taller

# El secreto de la instancia. Se genera una vez, por SSH, en el propio NAS:
#
#   openssl rand -hex 32
#
# Y no se cambia nunca: al rotarlo dejan de valer las claves de administrador y
# todas las sesiones abiertas, así que habría que volver a entrar en la app.
INSTANCE_SECRET=

# La dirección pública de la API de Convex, la que alcanza el navegador. Tiene
# que coincidir con el destino del proxy inverso y con la dirección con la que se
# compila la app: el docker-compose.yml se la pasa al construirla
# (`VITE_CONVEX_URL`), así que este valor manda en los dos sitios. Si cambia, hay
# que reconstruir el proyecto: la app la lleva grabada dentro.
# Es también a donde sube las funciones el contenedor `funciones`, así que tiene
# que estar en pie (con su HTTPS) cuando el proyecto arranca.
CONVEX_CLOUD_ORIGIN=https://api.tudominio.com

# La dirección pública de la aplicación, la que se teclea en el navegador. Las
# funciones la usan para construir los enlaces que mandan (el aviso de una
# incidencia, el resumen semanal), y tiene que coincidir con el destino del proxy
# inverso del sitio.
SITE_URL=https://taller.tudominio.com

# La clave de administrador del backend. **Se pide al backend**, que la firma con
# el secreto de la instancia, así que no se puede saber hasta que haya arrancado
# una vez (paso 5 de la guía):
#
#   sudo docker compose exec backend ./generate_admin_key.sh | tail -1
#
# Mientras esté vacía, el contenedor `funciones` arranca, lo dice y se para: el
# taller sigue en pie, pero las funciones todavía no están subidas. Se pega aquí y
# se arranca el proyecto otra vez.
CONVEX_ADMIN_KEY=

# De quién firma las sesiones la plataforma. No se toca salvo que se use otra.
# VLY_CONVEX_AUTH_ISSUER=https://freebuff.com

# Las integraciones de la plataforma (el código de acceso por email y el resumen
# semanal). Solo hacen falta si el taller las usa: el acceso por contraseña y como
# invitado funcionan dentro del propio NAS, sin ellas.
# VLY_INTEGRATION_KEY=
# VLY_INTEGRATION_BASE_URL=https://integrations.freebuff.com/

# Las claves con las que el deployment firma sus propias sesiones
# (`JWT_PRIVATE_KEY` y `JWKS`) **no van aquí**: las genera el contenedor
# `funciones` la primera vez, dentro del backend, y solo cuando faltan —volver a
# generarlas cerraría todas las sesiones abiertas—.

# Cuánto se guardan los documentos que el backend ya no usa (segundos). Dos días
# por defecto, igual que en el entorno local.
# DOCUMENT_RETENTION_DELAY=172800

# Cuánto cuenta el backend en sus logs. `info` va bien; `debug` solo para mirar.
# RUST_LOG=info

# --- El modo de instalación --------------------------------------------------
#
# Un taller recién instalado arranca con la base **vacía**: no se carga ninguna
# muestra de ejemplo, porque los datos del taller los das tú de alta. Lo que sí
# queda hecho es la **cuenta de administrador**, para no tener que entrar a
# crearla y para que el primero que se registre no acabe siendo administrador por
# ser el primero.
#
# `empty` (por defecto) deja esa cuenta creada cuando la base no tiene ninguna
# cuenta; con `no` no se toca ninguna, y el taller queda igual de vacío. En los
# dos casos el taller arranca sin datos de ejemplo.
# PULSO_INSTALL=empty
#
# Las credenciales de esa cuenta. Si no las pones se usan las de la guía
# (`admin@taller.es` / `admin12345`) — **cámbialas aquí antes de la primera
# puesta en marcha** si el taller va a estar publicado en internet.
# ADMIN_EMAIL=admin@taller.es
# ADMIN_PASSWORD=admin12345
